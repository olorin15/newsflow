# Copy to .env and fill in. newsflow loads .env automatically (python-dotenv).
# NEVER commit your real .env — it is listed in .gitignore.

# Telegram (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Email delivery (use a Gmail App Password, not your real password)
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Recipient(s) for briefings — comma-separated if several: EMAIL_TO=a@x.com, b@y.com
EMAIL_TO=

# Mistral cloud backend (optional)
MISTRAL_API_KEY=

# SerpApi Google News search (optional, for `collect-serp`)
SERP_API_KEY=

# Medium publishing (optional)
MEDIUM_TOKEN=
MEDIUM_USER_ID=

# Substack notes publishing (optional)
SUBSTACK_EMAIL=
SUBSTACK_PASSWORD=
